{
  "name": "btc-minute",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "pnpm run typecheck && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx server/src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:integration": "TEST_DATABASE_URL=postgres://btc:btc@localhost:5433/btc_test vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify:live": "node --env-file=.env scripts/verify-live.mjs",
    "deploy": "sst deploy --stage reda",
    "deploy:remove": "sst remove --stage reda",
    "sst:dev": "sst dev --stage reda",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sst": "^4.17.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
